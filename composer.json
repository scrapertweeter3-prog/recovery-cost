  "type": "library",
  "license": "MIT",
  "homepage": "https://hackedself.com",
  "authors": [
    {
      "name": "James Verlander",
      "email": "scrapertweeter3@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
